{
  "name": "fighterjet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w @fighterjet/client",
    "dev:server": "npm run dev -w @fighterjet/server",
    "build": "npm run build -w @fighterjet/client",
    "start": "npm run start -w @fighterjet/server",
    "test": "npm run test -w @fighterjet/shared && npm run test -w @fighterjet/server",
    "typecheck": "npm run typecheck -w @fighterjet/shared && npm run typecheck -w @fighterjet/client && npm run typecheck -w @fighterjet/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
